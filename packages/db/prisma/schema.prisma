// Lidh.al platform — Prisma schema
// Multi-tenant SaaS: shared DB, tenantId on every domain row, RLS applied separately.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // "native" covers local dev (macOS arm64) + the Docker builder (linux-musl
  // from node:22-alpine). "debian-openssl-3.0.x" covers the runtime image
  // (node:22-bookworm-slim). Without the debian target, the runtime crashes
  // on boot: "Prisma Client could not locate the Query Engine for runtime
  // debian-openssl-3.0.x".
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum MembershipRole {
  owner
  admin
  agent
}

// Lifecycle of a team invitation (ADR: plan-gated team membership). On the
// invitee's first sign-in the AuthGuard matches their verified email to a
// `pending` invite, creates the Membership, and flips it to `accepted`.
enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

enum ChannelKind {
  web
  whatsapp
  instagram
}

enum ChannelStatus {
  pending
  connected
  disconnected
  error
}

enum KnowledgeSourceKind {
  url
  file
  faq
  sitemap
}

enum KnowledgeSourceStatus {
  pending
  processing
  ready
  failed
}

enum ConversationStatus {
  open
  paused
  resolved
}

enum MessageRole {
  user
  assistant
  tool
}

enum LeadStatus {
  new_      @map("new") // `new` is a JS reserved word; identifier is `new_`, DB value is "new"
  contacted
  won
  lost
}

enum EventKind {
  lead_captured
  human_handoff_requested
  agent_paused
  agent_resumed
  conversation_assigned
  conversation_started
  contact_registered
  channel_connected
  channel_disconnected
  knowledge_source_indexed
  knowledge_source_failed
  funnel_visited
}

// Tag on Conversation. Lets us reuse the same agent runtime + tables for
// real customer chats AND internal preview/test sessions, while keeping the
// SMB inbox clean (filtered to `kind = customer` by default) and excluding
// non-customer conversations from usage rollups.
enum ConversationKind {
  customer
  preview
}

// Whether a property is for sale or for rent (ADR-016 real-estate vertical).
enum PropertyListingType {
  sale
  rent
}

// Tenant service state (ADR-008). `archived` = subscription paused: the agent
// stops serving end-customers on every channel, but all data is retained and
// the dashboard stays readable so the operator can review/export. Reversible
// via reactivate. Hard delete is a row delete (cascades), not a status.
enum TenantStatus {
  active
  archived
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity (global — not tenant-scoped)
// ─────────────────────────────────────────────────────────────────────────────

// Standard persona presets (ADR-010, revises ADR-009 storage). Platform-wide,
// editable from the dashboard "Persona presets" admin screen — no deploy.
// Seeded on first boot from @lidh/core PERSONA_PRESETS (create-if-missing,
// never overwrites edits). `personas` = { al, en, it, fr, de } with the
// {business} token. `createTenant` resolves a preset from HERE (not code),
// then expands it into one AgentPersona row per language. Presets are copied
// at create time (no FK from tenants), so a preset can be edited/removed
// without affecting already-created tenants. Remove = soft (active=false).
model PersonaPreset {
  id          String   @id @default(cuid()) // seeded rows use stable ids ("restaurant"…)
  label       String
  description String
  personas    Json // { al, en, it, fr, de } — may contain {business}
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model User {
  id              String   @id @default(cuid())
  clerkId         String   @unique
  email           String   @unique
  name            String?
  imageUrl        String?
  // Lidh.al staff flag (synced from Clerk publicMetadata.role === "platform_admin").
  // Lets you see all tenants and create/configure them on behalf of clients.
  isPlatformAdmin Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships           Membership[]
  sentInvitations       Invitation[]   @relation("InvitationInviter")
  assignedConversations Conversation[] @relation("ConversationAssignee")

  @@index([clerkId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Tenant + membership
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id   String @id @default(cuid())
  slug String @unique
  name String

  // ─── Plan / billing ─────────────────────────────────────────────────────
  // FK to Plan. Nullable so a freshly-created tenant can exist before being
  // assigned a plan (admin onboarding flow). App code blocks usage on tenants
  // without a plan unless they're on trial. Limits are read from Plan and
  // optionally overridden per-tenant via planOverrides JSON below.
  planId        String?
  // Per-tenant override (negotiated deals, gifts, temporary boosts). Merged
  // on top of Plan limits. Validated by Zod in packages/core. Example:
  //   { messagesPerMonth: 10000, expiresAt: "2026-12-31T00:00:00Z" }
  planOverrides Json      @default("{}")
  // Trial window. null = not on a trial. Set to a future date to grant the
  // tenant Pro-tier features until that moment regardless of planId.
  trialEndsAt   DateTime?

  // The SMB's primary language. New conversations default to this if no locale
  // is detected from the channel. Use Lidh.al internal codes: "al", "en", "it",
  // "de", "fr", ... (we map "al" -> "sq" only when handing off to BCP-47 APIs).
  defaultLocale String @default("al")
  settings      Json   @default("{}")

  // ─── Funnel lifecycle (ADR-014) ─────────────────────────────────────────
  // Every tenant gets a permanent funnel page at app.lidh.al/b/<slug> from
  // day one. There's no separate "demo URL" anymore — the URL is the
  // tenant's storefront. Whether the funnel is *live* is decided by
  // `isTenantActive`:
  //   - trialEndsAt > now           → active (trial)
  //   - planId set + plan not lapsed → active (paid)
  //   - else                         → /b/<slug> shows "currently offline"
  //
  // Replaces the earlier `isDemo` + `demoToken` + `demoExpiresAt` design.
  // For Albanian SMBs without their own website, the funnel URL is too
  // valuable to expire mid-funnel — gate the *service*, not the *URL*.

  // ─── Owner binding (ADR-015) ────────────────────────────────────────────
  // When an admin provisions a tenant on behalf of a customer who hasn't
  // signed up yet, we stash their email here. The AuthGuard's JIT-user step
  // scans this column on every brand-new sign-in: if an email match is
  // found, the new User is bound as `owner` and the field is nulled out.
  // No invite-token / email infra needed.
  pendingOwnerEmail String?

  // ─── Service lifecycle (ADR-008) ────────────────────────────────────────
  // active → archived (subscription paused; agent stops serving, data kept,
  // reversible) → row delete (cascades all tenant data). Existing rows
  // backfill to `active` via the enum default.
  status     TenantStatus @default(active)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan             Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  memberships      Membership[]
  invitations      Invitation[]
  agents           Agent[]
  agentPersonas    AgentPersona[]
  channels         Channel[]
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  leads            Lead[]
  events           Event[]
  usageDaily       UsageDaily[]
  properties       Property[]

  @@index([planId])
  @@index([pendingOwnerEmail])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plans — pricing tiers + capability matrix
// ─────────────────────────────────────────────────────────────────────────────
//
// Limits are data, not code. Adding/editing a plan = one row, no deploy.
// Per-tenant deviations live in Tenant.planOverrides (JSON merged on top).
// Soft caps (warn) vs hard caps (block) are decided by the app layer based
// on dimension — typically: messages = soft, channels/seats = hard.
//
// Plans are seeded after the first migration (M1) — for now this table is
// allowed to be empty; tenants without a planId fall through to "no plan"
// behavior in code.

model Plan {
  id                  String   @id @default(cuid())
  slug                String   @unique // "basic", "premium"
  name                String // human-readable
  // Pricing (EUR, whole euros). No "free" plan — the only free offering is the
  // 30-day trial (Tenant.trialEndsAt), which is not a Plan row.
  priceEurPerMonth    Int      @default(0)
  priceEurPerYear     Int      @default(0) // typically 10x monthly (2 months free)
  setupFeeEur         Int      @default(0) // one-time onboarding fee
  // Quota dimensions (per calendar month). 0 = unlimited.
  conversationsPerMonth Int    @default(0) // the billing dimension
  messagesPerMonth    Int      @default(0)
  leadsPerMonth       Int      @default(0)
  // Hard feature caps.
  maxChannels         Int      @default(1)
  maxLanguages        Int      @default(1)
  maxKnowledgeSources Int      @default(5)
  maxTeamMembers      Int      @default(1)
  // Capability flags — keeps schema stable as we add features. Example:
  //   { hasInstagram: true, hasWhatsApp: true, hasCustomBranding: false,
  //     hasApiAccess: false, hasCrmExport: false }
  features            Json     @default("{}")
  // Soft-archive a plan when retiring it (existing tenants keep their planId
  // but new tenants can't pick this plan).
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenants Tenant[]
}

model Membership {
  id        String         @id @default(cuid())
  userId    String
  tenantId  String
  role      MembershipRole @default(agent)
  createdAt DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

// A pending/historical invitation for someone to join a tenant's team. One row
// per (tenant, email) — re-inviting upserts this row back to `pending`. Seat
// usage = active memberships + `pending` invitations, capped by the tenant's
// effective plan (Plan.maxTeamMembers; trial = Premium-level). Roles via invite
// are `admin` or `agent` only — the `owner` is set by a platform admin.
model Invitation {
  id          String           @id @default(cuid())
  tenantId    String
  email       String
  role        MembershipRole   @default(agent)
  status      InvitationStatus @default(pending)
  invitedById String? // User.id of the inviter; null if platform-admin/system
  expiresAt   DateTime
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agent configuration (per tenant — multi-agent allowed but UI surfaces one)
// ─────────────────────────────────────────────────────────────────────────────

model Agent {
  id               String   @id @default(cuid())
  tenantId         String
  name             String
  // Fallback locale used when a conversation has no locale, or when the
  // requested locale has no matching AgentPersona. Defaults to "al".
  defaultLocale    String   @default("al")
  tone             Json     @default("{}") // e.g. { warmth: 0.7, formality: 0.5 }
  fallbackBehavior Json     @default("{}") // e.g. { handoff_after_n_unsure: 2 }
  toolsEnabled     Json     @default("{\"capture_lead\":true,\"request_human_handoff\":true}")
  modelOverride    String? // null = use platform default (claude-haiku-4-5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personas AgentPersona[]

  @@index([tenantId])
}

// One persona per (agent, language). Adding a language for a tenant = inserting
// a row here. No schema migration needed when a customer wants Italian + German.
model AgentPersona {
  id        String   @id @default(cuid())
  agentId   String
  tenantId  String // denormalized for RLS
  locale    String // "al" | "en" | "it" | "de" | "fr" | ...
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent  Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([agentId, locale])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Channels — web widget / WhatsApp / Instagram
// ─────────────────────────────────────────────────────────────────────────────

model Channel {
  id             String        @id @default(cuid())
  tenantId       String
  kind           ChannelKind
  status         ChannelStatus @default(pending)
  // Channel-specific config (kept as JSON for flexibility):
  //   web:       { allowedOrigins: string[], theme: {...} }
  //   whatsapp:  { phoneNumberId, wabaId, displayPhoneNumber }
  //   instagram: { igAccountId, pageId }
  config         Json          @default("{}")
  // Encrypted credential blob (Meta access token, etc). Decryption key in env, not DB.
  credentialsEnc String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([tenantId, kind]) // one of each kind per tenant; relax later if needed
}

// ─────────────────────────────────────────────────────────────────────────────
// Knowledge base (RAG sources + embedded chunks)
// ─────────────────────────────────────────────────────────────────────────────

model KnowledgeSource {
  id            String                @id @default(cuid())
  tenantId      String
  kind          KnowledgeSourceKind
  uri           String                @db.Text // URL, file storage key, or FAQ id
  status        KnowledgeSourceStatus @default(pending)
  lastCrawledAt DateTime?
  error         String?               @db.Text
  meta          Json                  @default("{}")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([tenantId, status])
}

model KnowledgeChunk {
  id        String                       @id @default(cuid())
  tenantId  String // denormalized for RLS + WHERE on vector queries
  sourceId  String
  content   String                       @db.Text
  // Optional locale tag — set during ingestion (langdetect on the source).
  // Lets retrieval prefer chunks matching the conversation's locale.
  locale    String?
  // pgvector embedding — Prisma can't query/order by similarity; we use raw SQL.
  // Dimension 1536 matches OpenAI ada-002 / Voyage-2; we'll standardize on Voyage AI for now.
  embedding Unsupported("vector(1536)")?
  meta      Json                         @default("{}")
  tokens    Int? // approximate token count for the chunk
  createdAt DateTime                     @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  // Vector index (ivfflat / hnsw) is added in a separate raw-SQL migration —
  // Prisma can't express it directly.

  @@index([tenantId])
  @@index([sourceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Contacts (the SMB's customers — unified across channels by phone/email/handle)
// ─────────────────────────────────────────────────────────────────────────────

model Contact {
  id          String   @id @default(cuid())
  tenantId    String
  name        String?
  phone       String?
  email       String?
  igHandle    String?
  source      String? // first channel we saw them on: "web" | "whatsapp" | "instagram"
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  meta        Json     @default("{}")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  leads         Lead[]

  // Cross-channel unification: same phone/email per tenant collapses to one contact
  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@unique([tenantId, igHandle])
  @@index([tenantId, lastSeenAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversations + messages
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id               String             @id @default(cuid())
  tenantId         String
  channelId        String // FK to Channel
  contactId        String
  // customer = real visitor (default; the only kind that surfaces in the SMB inbox
  //            and counts toward usage rollups).
  // preview  = platform admin (you) or tenant owner/admin testing the agent.
  kind             ConversationKind   @default(customer)
  status           ConversationStatus @default(open)
  aiPaused         Boolean            @default(false) // human takeover toggle
  assignedToUserId String?
  // Locale pinned at thread start (from widget locale, WA user lang, IG locale).
  // Falls back to Tenant.defaultLocale at write time if null.
  locale           String?
  // Channel-specific thread id (WA conversation id, IG thread id, web session)
  channelRef       String?
  startedAt        DateTime           @default(now())
  lastMsgAt        DateTime           @default(now())
  // When an operator last opened this thread in the inbox. Unread = visitor
  // messages newer than this (null = never read → all visitor msgs unread).
  // Shared/team read state (one marker per conversation, not per user).
  lastReadAt       DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("ConversationAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages   Message[]
  leads      Lead[]
  events     Event[]

  @@index([tenantId, lastMsgAt])
  @@index([tenantId, status])
  @@index([tenantId, kind, lastMsgAt]) // inbox query: WHERE kind='customer'
  @@index([contactId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  tenantId       String // denormalized
  role           MessageRole
  contentText    String?     @db.Text
  contentJson    Json? // rich content (attachments, structured replies)
  // Tool-call fields (only populated when role = "tool" or assistant emitted a tool call):
  toolName       String?
  toolInput      Json?
  toolOutput     Json?
  // Anthropic token counts for THIS message turn — pulled from response.usage.
  // Only populated for assistant messages (visitor turns have no LLM cost).
  // UsageDaily aggregates these into per-tenant per-channel daily totals.
  tokensIn       Int?
  tokensOut      Int?
  createdAt      DateTime    @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads (captured by the agent or manually)
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id             String     @id @default(cuid())
  tenantId       String
  conversationId String?
  contactId      String?
  payload        Json       @default("{}") // { name, email, phone, message, ... }
  status         LeadStatus @default(new_)
  capturedAt     DateTime   @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, capturedAt])
  @@index([tenantId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Events (append-only audit/analytics log)
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id             String    @id @default(cuid())
  tenantId       String
  conversationId String?
  kind           EventKind
  meta           Json      @default("{}")
  createdAt      DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, kind, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Usage rollups — denormalized daily aggregates per (tenant, channel)
// ─────────────────────────────────────────────────────────────────────────────
//
// One row per (tenantId, date, channel). Populated by a nightly Inngest job
// that aggregates the previous UTC day from messages/leads/events. Excludes
// Conversation.kind != 'customer' so preview/test sessions don't count toward
// the SMB's usage. Live "today" data falls back to live COUNT/SUM queries on
// the source tables until the job runs.
//
// Per-channel granularity lets the dashboard show "WhatsApp drove 60% of leads
// this month" without scanning the messages table.

model UsageDaily {
  id            String      @id @default(cuid())
  tenantId      String
  date          DateTime    @db.Date
  channel       ChannelKind
  messagesIn    Int         @default(0) // visitor messages
  messagesOut   Int         @default(0) // assistant messages
  conversations Int         @default(0) // new conversations started this day
  leadsCaptured Int         @default(0)
  toolCalls     Int         @default(0)
  tokensIn      Int         @default(0) // Anthropic prompt tokens
  tokensOut     Int         @default(0) // Anthropic completion tokens

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, channel])
  @@index([tenantId, date(sort: Desc)])
  @@index([tenantId, channel, date])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property — structured real-estate inventory (ADR-016)
// ─────────────────────────────────────────────────────────────────────────────
//
// The real-estate vertical needs precise, structured search (filter by city,
// price, size, rooms, baths; "nearest area" fallback) that semantic RAG over
// KnowledgeChunk cannot do. Each Property is one listing with typed columns,
// scoped per tenant, and a canonical `sourceUrl` so the agent can hand the
// visitor an exact, verbatim link. Populated by a per-source ingest (e.g. the
// Houzez scraper) rather than the prose crawler. The `search_properties` agent
// tool queries this table.
model Property {
  id         String @id @default(cuid())
  tenantId   String
  // Stable per-listing id from the source system (e.g. Houzez "B221258").
  // Unique per tenant so re-ingests upsert instead of duplicating.
  externalId String

  title        String
  listingType  PropertyListingType // sale | rent
  propertyType String // free-text category from source, e.g. "Apartamente", "Vile", "Magazina"

  // Location. `city` + `area` (neighborhood/zone) drive filtering and the
  // city-adjacency "nearest area" fallback. lat/lng kept nullable for a future
  // true-distance upgrade; not populated in the v1 Houzez ingest.
  city    String
  area    String?
  address String?
  lat     Float?
  lng     Float?

  priceEur    Int?
  bedrooms    Int?
  bathrooms   Int?
  areaSqm     Int?
  floor       Int?
  description String?

  sourceUrl String // canonical per-property detail page (handed to the visitor verbatim)
  photoUrl  String?

  // Listing availability. Re-ingest marks delisted properties; search filters
  // to `available` so sold/rented units aren't surfaced.
  status String @default("available")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, status, city, listingType])
  @@index([tenantId, status, listingType, priceEur])
  @@index([tenantId, status, bedrooms])
}
