# apps/dashboard — local environment.
# Copy this file to `.env.local` (or `.env`, both are gitignored) and fill in
# the real values. Production values live on Vercel as env vars.

# Clerk — get keys from https://dashboard.clerk.com → your app → API keys.
# These specific names are required by @clerk/nextjs.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where Clerk sends the user after auth (if no explicit redirect_url).
# Without these, Clerk defaults to "/" and you bounce through the root route.
# Pointing straight at /inbox makes post-login deterministic.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/tenants
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/tenants
# Also tell Clerk where the sign-in/up pages live (we host them ourselves).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# API origin. Used directly ONLY for the public chat SSE; authenticated data
# calls go via the BFF proxy (/api/proxy → API, ADR-006).
#   dev:  http://localhost:4000
#   prod: https://api.lidh.al
NEXT_PUBLIC_API_URL=http://localhost:4000

# This dashboard's own origin — used to build the absolute BFF-proxy URL so
# api.ts works in both server and client components.
#   dev:  http://localhost:3001
#   prod: https://app.lidh.al
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional: same Neon DATABASE_URL as packages/db/.env. Only needed if the
# dashboard queries Postgres directly via @lidh/db (platform-admin views,
# Clerk webhook handler). Most tenant data should go through @lidh/api.
DATABASE_URL=

# Clerk webhook signing secret. Set in M2 when wiring the user-mirroring
# webhook. Get it from Clerk dashboard → Webhooks → your endpoint → Signing
# secret. Leave empty in M1 — the route returns 503 until set.
CLERK_WEBHOOK_SECRET=
