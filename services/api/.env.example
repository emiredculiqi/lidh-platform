# services/api — local environment.
# Copy to .env (gitignored). Production values live on Fly.io as secrets.

# HTTP server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. Wildcard "*" only in dev.
CORS_ORIGINS=*

# Database — same Neon string as packages/db/.env
DATABASE_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Anthropic — the agent runtime (@lidh/core). Required for /v1/chat/web to
# actually generate replies. Without it, chat returns an error event.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI — ONLY used for embeddings (RAG knowledge retrieval), model
# text-embedding-3-small. Without it, retrieval is skipped gracefully and the
# agent answers from persona + business facts only. Required for the seed
# script (2.1.6) and real knowledge-grounded answers.
OPENAI_API_KEY=""

# Object storage for uploaded documents (S3-compatible: MinIO | R2 | S3).
# OPTIONAL — if unset, document upload still extracts+embeds for RAG; only
# original-file retention / reingest-from-original is unavailable.
# Local dev (MinIO standalone binary): endpoint http://localhost:9000,
# S3_FORCE_PATH_STYLE=true, region "auto".
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# WhatsApp webhook verification token (Meta-style GET handshake). Set this
# when wiring a real provider in M4.4; the inbound POST works without it in
# dev (provider-specific signature verification also lands in M4.4).
WHATSAPP_VERIFY_TOKEN=

# Base URL used to build demo links: <DEMO_BASE_URL>/<demoToken>.
# Dev: http://localhost:3001/demo  (the dashboard's public /demo/[token] page)
# Prod: https://demo.lidh.al       (wired at deploy)
DEMO_BASE_URL=http://localhost:3001/demo

# Swagger/OpenAPI docs at /docs. Auto-enabled when NODE_ENV != production.
# Set to "true" to also expose docs in production.
ENABLE_SWAGGER=
