# services/api — local environment.
# Copy to .env (gitignored). Production values live on Fly.io as secrets.

# HTTP server
PORT=4000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. Wildcard "*" only in dev.
CORS_ORIGINS=*

# Database — same Neon string as packages/db/.env
DATABASE_URL="postgresql://USER:PASSWORD@HOST.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Anthropic (used by the agent runtime — not wired in M1, just placeholder)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=claude-haiku-4-5
