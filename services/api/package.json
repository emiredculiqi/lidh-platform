{
  "name": "@lidh/api",
  "version": "0.0.0",
  "private": true,
  "description": "Lidh.al platform API — agent runtime, REST endpoints, channel adapters",
  "scripts": {
    "dev": "nest start --watch --builder swc --type-check",
    "build": "nest build --builder swc",
    "start": "node dist/main.js",
    "lint": "echo \"(eslint config to be added in M2)\" && exit 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@clerk/backend": "^3.4.9",
    "@fastify/static": "^7.0.4",
    "@lidh/core": "workspace:^",
    "@lidh/db": "workspace:*",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-fastify": "^10.4.4",
    "@nestjs/swagger": "^8.1.1",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^4.28.1",
    "mammoth": "^1.12.0",
    "openai": "^6.38.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.26",
    "@types/node": "^22.7.4",
    "@types/pdf-parse": "^1.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  }
}
