  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.26",
    "@types/node": "^22.7.4",
    "ts-node": "^10.9.2",
